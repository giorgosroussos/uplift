includes:
    - vendor/larastan/larastan/extension.neon
    - vendor/nesbot/carbon/extension.neon

parameters:
    paths:
        - app/
        - bootstrap/app.php
        - config/
        - database/
        - routes/
        - scripts/

    level: 6

    ignoreErrors:
        # Used by the tenant-owned models of later tasks; until then PHPStan
        # reports it as unused.
        -
            identifier: trait.unused
            path: app/Modules/Tenancy/Concerns/BelongsToOrganization.php
            reportUnmatched: false
